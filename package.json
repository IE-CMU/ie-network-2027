{
  "name": "ie_network_2027_prototype",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "run-p dev:server dev:worker",
    "dev:server": "astro dev",
    "dev:worker": "tsx src/lib/queue/worker.ts",
    "build": "run-s build:server build:worker",
    "build:server": "astro build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "start:worker": "node dist-worker/worker.js",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "cross-env NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:push": "cross-env NODE_OPTIONS='--import tsx' drizzle-kit push",
    "db:migrate": "cross-env NODE_OPTIONS='--import tsx' drizzle-kit migrate",
    "db:prototype": "tsx ./src/db/prototype.ts",
    "eol": "eolConverter _entrypoint/*.sh"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/vue": "^7.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "bullmq": "^6.2.0",
    "daisyui": "^5.7.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eol-converter-cli": "^1.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
