---
import TypeChangeForm from '@components/user/TypeChangeForm.vue'
import { type Locale } from '@utils/locale'
import { getRelativeLocaleUrl } from 'astro:i18n'
interface Props {
  locale: Locale
}
const { locale } = Astro.props

const t = (th: string, en: string) => (locale === 'th' ? th : en)

const detailsUrl = getRelativeLocaleUrl(locale, '/user/details')
---

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <a href={detailsUrl} class="link link-hover text-base-content/70 text-sm">
    ← {t('กลับไปที่บัญชีของฉัน', 'Back to My Account')}
  </a>

  <h1 class="text-4xl font-bold mt-4 mb-12 text-center">
    {t('ขอเปลี่ยนประเภทผู้เข้าร่วม', 'Change Participant Type')}
  </h1>

  <section class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body">
      <TypeChangeForm client:load locale={locale} detailsUrl={detailsUrl} />
    </div>
  </section>
</main>
