---
import PasswordSetting from '@components/user/PasswordSetting.vue'
import { auth } from '@lib/auth/server'
import { type Locale } from '@utils/locale'
import { getRelativeLocaleUrl } from 'astro:i18n'
interface Props {
  locale: Locale
}
const { locale } = Astro.props

// Middleware guarantees a user on /user/password-setting, but guard anyway.
const user = Astro.locals.user

const t = (th: string, en: string) => (locale === 'th' ? th : en)

const detailsUrl = getRelativeLocaleUrl(locale, '/user/details')

// A 'credential' account means the user has a password; magic-link-only
// participants have none. Decides between "Set" and "Change" password.
let hasPassword = false
if (user) {
  try {
    const accounts = await auth.api.listUserAccounts({
      headers: Astro.request.headers,
    })
    hasPassword = accounts.some((a) => a.providerId === 'credential')
  } catch (error) {
    console.error('Error listing user accounts:', error)
  }
}
---

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <a href={detailsUrl} class="link link-hover text-base-content/70 text-sm">
    ← {t('กลับไปที่บัญชีของฉัน', 'Back to My Account')}
  </a>

  <h1 class="text-4xl font-bold mt-4 mb-12 text-center">
    {t('ตั้งค่ารหัสผ่าน', 'Password Settings')}
  </h1>

  {
    user && (
      <section class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body">
          <PasswordSetting client:load locale={locale} hasPassword={hasPassword} />
        </div>
      </section>
    )
  }
</main>
