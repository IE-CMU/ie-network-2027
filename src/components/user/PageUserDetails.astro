---
import { getTypeChangeState, type TypeChangeState } from '@lib/typeChange/requests'
import { type Locale } from '@utils/locale'
import { PARTICIPANT_TYPE_LABELS, withStudentStatus } from '@utils/participantType'
import { BILLING_BLOCK_REASONS, TYPE_CHANGE_BILLING_MESSAGES } from '@utils/typeChangeRequest'
import { getRelativeLocaleUrl } from 'astro:i18n'
interface Props {
  locale: Locale
}
const { locale } = Astro.props

// Middleware guarantees a user on /user/details, but guard anyway.
const user = Astro.locals.user

const t = (th: string, en: string) => (locale === 'th' ? th : en)

const displayName = user?.name?.trim() || user?.email || ''
const initial = displayName.charAt(0).toUpperCase() || '?'

// th-TH uses the Buddhist calendar (e.g. 17 พฤศจิกายน 2569).
const formatDate = (date: Date | string | null | undefined) =>
  date
    ? new Intl.DateTimeFormat(locale === 'th' ? 'th-TH' : 'en-GB', {
        dateStyle: 'long',
      }).format(new Date(date))
    : '-'

const roleLabels: Record<string, { th: string; en: string }> = {
  admin: { th: 'ผู้ดูแลระบบ', en: 'Administrator' },
  user: { th: 'ผู้ใช้', en: 'User' },
}
const role = user?.role || 'user'
const roleLabel = roleLabels[role]?.[locale] ?? role

const passwordSettingUrl = getRelativeLocaleUrl(locale, '/user/password-setting')
const changeTypeUrl = getRelativeLocaleUrl(locale, '/user/change-type')

// Read from the database rather than the session, so a just-approved
// request shows the new type straight away.
let typeState: TypeChangeState | null = null
if (user) {
  try {
    typeState = await getTypeChangeState(user.id)
  } catch (error) {
    console.error('Error loading type change state:', error)
  }
}
const typeLabels = PARTICIPANT_TYPE_LABELS[locale]
const participantType = typeState?.participantType ?? user?.participantType ?? 'participant'
const request = typeState?.latest ?? null
// The type the request gives: same base (participant/author), plus the discount.
const requestedLabel = request ? typeLabels[withStudentStatus(participantType, request.requestedType)] : ''
const evidenceUrl = request?.hasEvidence ? `/api/type-change-request/${request.id}/evidence` : null

// Show the billing hint only when the billing address is all that stands
// in the way (not to users who cannot request a discount anyway).
const billingUrl = getRelativeLocaleUrl(locale, '/user/billing')
const reasons = typeState?.reasons ?? []
const billingReason =
  reasons.length > 0 && reasons.every((r) => BILLING_BLOCK_REASONS.includes(r))
    ? (reasons[0] as keyof (typeof TYPE_CHANGE_BILLING_MESSAGES)['en'])
    : null
const billingBlock = billingReason ? TYPE_CHANGE_BILLING_MESSAGES[locale][billingReason] : null
---

<main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <h1 class="text-4xl font-bold mb-12 text-center">
    {t('บัญชีของฉัน', 'My Account')}
  </h1>

  {
    user && (
      <section class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body gap-6">
          <!-- Header: avatar + name -->
          <div class="flex flex-col sm:flex-row items-center gap-5 text-center sm:text-left">
            <div class="avatar avatar-placeholder">
              <div class="w-20 rounded-full bg-[#9E76B4] text-white">
                {user.image ? (
                  <img src={user.image} alt={displayName} />
                ) : (
                  <span class="text-3xl">{initial}</span>
                )}
              </div>
            </div>
            <div class="min-w-0">
              <h2 class="text-2xl font-bold truncate">{displayName}</h2>
              <p class="text-base-content/70 truncate">{user.email}</p>
              <span class="badge badge-sm mt-2 bg-[#F3E5F5] text-[#6B4A80] border-0">
                {roleLabel}
              </span>
            </div>
          </div>

          <div class="divider my-0" />

          <!-- Details -->
          <dl class="grid grid-cols-1 sm:grid-cols-[12rem_1fr] gap-x-6 gap-y-4">
            <dt class="font-semibold text-base-content/70">
              {t('ชื่อ', 'Name')}
            </dt>
            <dd class="break-words">{user.name || '-'}</dd>

            <dt class="font-semibold text-base-content/70">
              {t('หน่วยงาน', 'Affiliation')}
            </dt>
            <dd class="break-words">{user.affiliation || '-'}</dd>

            <dt class="font-semibold text-base-content/70">
              {t('อีเมล', 'Email')}
            </dt>
            <dd class="flex flex-wrap items-center gap-2 break-all">
              {user.email}
              {user.emailVerified ? (
                <span class="badge badge-sm badge-success badge-soft">
                  {t('ยืนยันแล้ว', 'Verified')}
                </span>
              ) : (
                <span class="badge badge-sm badge-warning badge-soft">
                  {t('ยังไม่ยืนยัน', 'Not verified')}
                </span>
              )}
            </dd>

            <dt class="font-semibold text-base-content/70">
              {t('บทบาท', 'Role')}
            </dt>
            <dd>{roleLabel}</dd>

            <dt class="font-semibold text-base-content/70">
              {t('ประเภทผู้เข้าร่วม', 'Participant type')}
            </dt>
            <dd class="flex flex-wrap items-center gap-2">
              {typeLabels[participantType]}
              {request?.status === 'pending' && (
                <span class="badge badge-sm badge-info badge-soft">
                  {t('รอตรวจสอบคำขอเปลี่ยน', 'Change pending')}
                </span>
              )}
            </dd>

            <dt class="font-semibold text-base-content/70">
              {t('เป็นสมาชิกตั้งแต่', 'Member since')}
            </dt>
            <dd>{formatDate(user.createdAt)}</dd>

            <dt class="font-semibold text-base-content/70">
              {t('อัปเดตล่าสุด', 'Last updated')}
            </dt>
            <dd>{formatDate(user.updatedAt)}</dd>
          </dl>

          <!-- Latest participant type change request -->
          {request && (
            <div
              role="status"
              class:list={[
                'alert alert-soft text-sm items-start',
                request.status === 'pending' && 'alert-info',
                request.status === 'approved' && 'alert-success',
                request.status === 'rejected' && 'alert-error',
              ]}
            >
              <div class="flex flex-col gap-1">
                <span class="font-semibold">
                  {request.status === 'pending' &&
                    t(
                      `คำขอเปลี่ยนประเภทเป็น "${requestedLabel}" (ส่งเมื่อ ${formatDate(request.submittedAt)}) อยู่ระหว่างการตรวจสอบ`,
                      `Your request to change to "${requestedLabel}" (submitted ${formatDate(request.submittedAt)}) is waiting for review.`
                    )}
                  {request.status === 'approved' &&
                    t(
                      `คำขอเปลี่ยนประเภทเป็น "${requestedLabel}" ได้รับการอนุมัติเมื่อ ${formatDate(request.statusChangedAt)}`,
                      `Your request to change to "${requestedLabel}" was approved on ${formatDate(request.statusChangedAt)}.`
                    )}
                  {request.status === 'rejected' &&
                    t(
                      `คำขอเปลี่ยนประเภทเป็น "${requestedLabel}" ไม่ได้รับการอนุมัติเมื่อ ${formatDate(request.statusChangedAt)}`,
                      `Your request to change to "${requestedLabel}" was rejected on ${formatDate(request.statusChangedAt)}.`
                    )}
                </span>
                {request.reviewerComment && (
                  <span class="whitespace-pre-line">
                    {request.status === 'rejected' ? t('เหตุผล: ', 'Reason: ') : t('หมายเหตุ: ', 'Note: ')}
                    {request.reviewerComment}
                  </span>
                )}
                {request.status === 'rejected' && typeState?.canRequest && (
                  <span>{t('คุณสามารถส่งคำขอใหม่ได้', 'You can submit a new request.')}</span>
                )}
                {evidenceUrl && (
                  <a href={evidenceUrl} target="_blank" rel="noopener" class="link w-fit">
                    {t('ดูไฟล์หลักฐานที่อัปโหลด', 'View uploaded evidence')}
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- Could request a discount, but needs exactly one billing address first -->
          {billingBlock && (
            <div role="status" class="alert alert-warning alert-soft text-sm items-start">
              <div class="flex flex-col gap-1">
                <span>{billingBlock}</span>
                <a href={billingUrl} class="link w-fit">
                  {t('จัดการที่อยู่สำหรับออกใบเสร็จ', 'Manage billing addresses')}
                </a>
              </div>
            </div>
          )}

          <div class="divider my-0" />

          <div class="card-actions justify-end">
            {typeState?.canRequest && (
              <a href={changeTypeUrl} class="btn btn-outline border-[#9E76B4] text-[#6B4A80] hover:bg-[#F3E5F5]">
                {request?.status === 'rejected'
                  ? t('ส่งคำขอเปลี่ยนประเภทใหม่', 'Submit a new type request')
                  : t('ขอเปลี่ยนประเภทผู้เข้าร่วม', 'Change participant type')}
              </a>
            )}
            <a
              href={passwordSettingUrl}
              class="btn border-0 bg-[#9E76B4] text-white hover:bg-[#8A62A0]"
            >
              {t('ตั้งค่ารหัสผ่าน', 'Password settings')}
            </a>
          </div>
        </div>
      </section>
    )
  }
</main>
