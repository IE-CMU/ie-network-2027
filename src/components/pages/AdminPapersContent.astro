---
import PaperTable, { type AdminPaperRow } from '@components/admin/PaperTable.vue'
import { dbClient } from '@db/client'
import { type Locale } from '@utils/locale'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const t = (th: string, en: string) => (locale === 'th' ? th : en)
const importUrl = getRelativeLocaleUrl(locale, '/admin/papers/import')

let papers: AdminPaperRow[] = []
let lastImport: Date | null = null
let activeCount = 0
let authorCount = 0
let loadError = false

try {
  const rows = await dbClient.query.paper.findMany({
    orderBy: (p, { asc }) => [asc(p.id)],
    with: { authors: { orderBy: (a, { asc }) => [asc(a.authorOrder)] } },
  })

  papers = rows.map((p) => {
    const contact = p.authors.find((a) => a.isPrimaryContact)
    return {
      id: p.id,
      title: p.title,
      primarySubjectArea: p.primarySubjectArea,
      status: p.status,
      isActive: p.isActive,
      primaryContact: contact ? { name: contact.authorName, email: contact.email } : null,
      authorCount: p.authors.length,
      authorSearch: p.authors
        .map((a) => `${a.authorName} ${a.email}`)
        .join(' ')
        .toLowerCase(),
    }
  })

  const active = rows.filter((p) => p.isActive)
  activeCount = active.length
  authorCount = new Set(active.flatMap((p) => p.authors.map((a) => a.email))).size
  lastImport = rows.reduce<Date | null>(
    (max, p) => (!max || p.importedAt > max ? p.importedAt : max),
    null
  )
} catch (error) {
  console.error('Error loading papers:', error)
  loadError = true
}

const formatDateTime = (date: Date | null) =>
  date
    ? new Intl.DateTimeFormat(locale === 'th' ? 'th-TH' : 'en-GB', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'Asia/Bangkok',
      }).format(date)
    : '-'
---

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
  <p class="text-sm font-semibold text-[#9E76B4] text-center">
    {t('แอดมิน', 'Admin')}
  </p>
  <h1 class="text-4xl font-bold mb-12 text-center">
    {t('บทความที่ได้รับการตอบรับ', 'Accepted Papers')}
  </h1>

  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <p class="font-semibold">
        {`${activeCount} ${t('บทความ', 'papers')}, ${authorCount} ${t('อีเมลผู้แต่ง', 'author emails')}`}
      </p>
      <p class="text-sm text-base-content/70">
        {t('นำเข้าล่าสุด', 'Last import')}: {formatDateTime(lastImport)}
      </p>
    </div>
    <a href={importUrl} class="btn border-0 bg-[#9E76B4] text-white hover:bg-[#8A62A0]">
      {t('นำเข้าจาก CMT', 'Import from CMT')}
    </a>
  </div>

  {
    loadError ? (
      <div role="alert" class="alert alert-error alert-soft">
        <span>{t('ไม่สามารถโหลดรายการบทความได้', 'Could not load the paper list.')}</span>
      </div>
    ) : papers.length === 0 ? (
      <p class="text-base-content/70">{t('ยังไม่มีบทความ', 'No papers yet.')}</p>
    ) : (
      <PaperTable client:load locale={locale} papers={papers} />
    )
  }
</main>
