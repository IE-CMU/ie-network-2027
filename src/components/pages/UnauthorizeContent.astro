---
import { type Locale } from '@utils/locale'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const t = (th: string, en: string) => (locale === 'th' ? th : en)
const homeUrl = getRelativeLocaleUrl(locale, '/')
const loginUrl = getRelativeLocaleUrl(locale, '/login')
---

<main
  class="min-h-[calc(100vh-4.5rem)] bg-gradient-to-b from-[#F3E5F5] to-white px-4 py-12 sm:py-20"
>
  <div class="mx-auto w-full max-w-md">
    <div class="card border border-base-300 bg-base-100 shadow-lg">
      <div class="card-body items-center gap-6 p-6 text-center sm:p-8">
        <!-- Icon -->
        <div
          class="flex h-20 w-20 items-center justify-center rounded-full bg-[#F3E5F5] text-[#7E5A94]"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-10 w-10"
          >
            <rect x="4" y="10" width="16" height="11" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
            <circle cx="12" cy="15.5" r="1.25" fill="currentColor"></circle>
          </svg>
        </div>

        <!-- Text -->
        <div>
          <p class="text-sm font-semibold tracking-widest text-[#9E76B4]">401</p>
          <h1 class="mt-1 text-3xl font-bold text-gray-900">
            {t('ไม่ได้รับอนุญาต', 'Unauthorized')}
          </h1>
          <p class="mt-3 text-gray-600">
            {
              t(
                'คุณไม่มีสิทธิ์เข้าถึงหน้านี้ กรุณาเข้าสู่ระบบก่อน',
                'You do not have permission to access this page. Please sign in first.',
              )
            }
          </p>
        </div>

        <!-- Actions -->
        <div class="flex w-full flex-col gap-3 sm:flex-row">
          <a
            href={loginUrl}
            class="btn flex-1 border-0 bg-[#9E76B4] text-white hover:bg-[#8A62A0]"
          >
            {t('เข้าสู่ระบบ', 'Sign in')}
          </a>
          <a
            href={homeUrl}
            class="btn btn-outline flex-1 border-[#9E76B4] text-[#7E5A94] hover:border-[#8A62A0] hover:bg-[#F3E5F5]"
          >
            {t('กลับหน้าหลัก', 'Back to home')}
          </a>
        </div>
      </div>
    </div>
  </div>
</main>
