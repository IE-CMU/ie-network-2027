---
import { type Locale } from '@utils/locale'
import { getRelativeLocaleUrl } from 'astro:i18n'
import LoginForm from '@components/auth/LoginForm.vue'
import MagicLink from '@components/auth/MagicLink.vue'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

const t = (th: string, en: string) => (locale === 'th' ? th : en)
const homeUrl = getRelativeLocaleUrl(locale, '/')
const loginUrl = getRelativeLocaleUrl(locale, '/login')
---

<main
  class="min-h-[calc(100vh-4.5rem)] bg-gradient-to-b from-[#F3E5F5] to-white px-4 py-12 sm:py-20"
>
  <div class="mx-auto w-full max-w-md">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-gray-900">
        {t('เข้าสู่ระบบ', 'Sign in')}
      </h1>
      <p class="mt-2 text-gray-600">
        {
          t(
            'เข้าสู่ระบบเพื่อจัดการบัญชีและการลงทะเบียน',
            'Sign in to manage your account and registration',
          )
        }
      </p>
    </div>

    <!-- Card -->
    <div class="card border border-base-300 bg-base-100 shadow-lg">
      <div class="card-body gap-6 p-6 sm:p-8">
        <!-- Magic link first: users have no password until they set one.
             Also the sign-up: an unknown email gets a participant account. -->
        <MagicLink
          client:load
          locale={locale}
          redirectUrl={homeUrl}
          errorUrl={loginUrl}
        />

        <div class="divider my-0 text-sm text-gray-500">
          {t('หรือเข้าสู่ระบบด้วยรหัสผ่าน', 'or sign in with a password')}
        </div>

        <LoginForm client:load locale={locale} redirectUrl={homeUrl} />
      </div>
    </div>
  </div>
</main>
