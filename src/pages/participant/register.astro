---
import Layout from '@layouts/Layout.astro'
import { getLocale } from '@utils/locale'
import RegisterContent from '@components/pages/participant/RegisterContent.astro'

// SSR: protected by src/middleware.ts (logged-in users).
export const prerender = false

const locale = getLocale(Astro)
---

<Layout title="Participant Register">
  <RegisterContent locale={locale} />
</Layout>
