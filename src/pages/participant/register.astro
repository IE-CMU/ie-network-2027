---
import Layout from '@layouts/Layout.astro'
import { getLocale } from '@utils/locale'
import ParticipantRegisterContent from '@components/pages/ParticipantRegisterContent.astro'

// SSR: protected by src/middleware.ts (logged-in users).
export const prerender = false

const locale = getLocale(Astro)
---

<Layout title="Participant Register">
  <ParticipantRegisterContent locale={locale} />
</Layout>
