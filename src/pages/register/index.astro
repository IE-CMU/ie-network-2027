---
import Layout from '@layouts/Layout.astro'
import { getLocale } from '@utils/locale'
import PageRegister from '@components/registration/PageRegister.astro'

// SSR: protected by src/middleware.ts (logged-in users).
export const prerender = false

const locale = getLocale(Astro)
---

<Layout title="Participant Register">
  <PageRegister locale={locale} />
</Layout>
