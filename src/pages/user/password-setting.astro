---
import Layout from '@layouts/Layout.astro'
import { getLocale } from '@utils/locale'
import PageUserPasswordSetting from '@components/user/PageUserPasswordSetting.astro'

// SSR: protected by src/middleware.ts (logged-in users).
export const prerender = false

const locale = getLocale(Astro)
---

<Layout title="Password Settings">
  <PageUserPasswordSetting locale={locale} />
</Layout>
