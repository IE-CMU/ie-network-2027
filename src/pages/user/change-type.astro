---
import Layout from '@layouts/Layout.astro'
import { getLocale } from '@utils/locale'
import { getTypeChangeState } from '@lib/typeChange/requests'
import PageUserChangeType from '@components/user/PageUserChangeType.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'

// SSR: protected by src/middleware.ts (logged-in users).
export const prerender = false

const locale = getLocale(Astro)

// Only users who may submit a request see the form (type is 'general', no
// pending or approved request). Others go back to their account page,
// which shows the request status.
const user = Astro.locals.user
const state = user ? await getTypeChangeState(user.id) : null
if (!state?.canRequest) {
  return Astro.redirect(getRelativeLocaleUrl(locale, '/user/details'))
}
---

<Layout title="Change Participant Type">
  <PageUserChangeType locale={locale} />
</Layout>
