---
import Layout from '@layouts/Layout.astro'
import AboutContent from '@components/site/AboutContent.astro'
import { getLocale } from '@utils/locale'

// This page needs to be SSR becuase of the session data for the menu.
export const prerender = false

const locale = getLocale(Astro)
---

<Layout title="About">
  <main>
    <AboutContent locale={locale} />
  </main>
</Layout>
