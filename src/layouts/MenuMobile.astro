---
import { type Locale } from '@utils/locale'
import LanguageSwitcher from './LanguageSwitcher.astro'
import { getUrlListCustom } from '@utils/locale'
import { type AccountMenu, type MenuItem, isMenuGroup } from '@layouts/menu'

interface Props {
  items: MenuItem[]
  account: AccountMenu
  locale: Locale
  LocaleUrlList: ReturnType<typeof getUrlListCustom>
}
const { items, account, locale, LocaleUrlList } = Astro.props
const { user } = account
---

<div class="drawer">
  <input id="my-drawer-1" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- Page content here -->
    <label for="my-drawer-1" class="btn drawer-button">
      <svg viewBox="0 0 100 80" width="20" height="20" fill="#9E76B4">
        <rect width="100" height="15"></rect>
        <rect y="30" width="100" height="15"></rect>
        <rect y="60" width="100" height="15"></rect>
      </svg>
    </label>
  </div>
  <div class="drawer-side">
    <label for="my-drawer-1" aria-label="close sidebar" class="drawer-overlay">
    </label>
    <ul class="menu bg-base-200 min-h-full w-80 p-4 text-base">
      <!-- Sidebar content here -->
      {
        items.map((item) =>
          isMenuGroup(item) ? (
            <li>
              <details>
                <summary>{item.label[locale]}</summary>
                <ul>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.url}>{child.label[locale]}</a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a href={item.url}>{item.label[locale]}</a>
            </li>
          ),
        )
      }

      <div class="divider my-2"></div>

      {
        user ? (
          <>
            <li class="menu-title flex-row items-center gap-3">
              <div class="avatar avatar-placeholder">
                <div class="w-8 rounded-full bg-[#9E76B4] text-white">
                  <span>{user.initial}</span>
                </div>
              </div>
              <span class="truncate text-base-content">{user.name}</span>
            </li>
            {account.links.map((link) => (
              <li>
                <a href={link.url}>{link.label[locale]}</a>
              </li>
            ))}
            <li>
              <button
                type="button"
                data-logout
                data-redirect={account.logout.redirectUrl}
              >
                {account.logout.label[locale]}
              </button>
            </li>
          </>
        ) : (
          <li>
            <a href={account.login.url}>{account.login.label[locale]}</a>
          </li>
        )
      }

      <li class="mt-4">
        <LanguageSwitcher
          locale={locale}
          localeUrlList={LocaleUrlList}
          class="justify-start"
        />
      </li>
    </ul>
  </div>
</div>
